{
  "dashboard": {
    "id": null,
    "uid": "sensor-monitoring",
    "title": "Jackbot Sensor Monitoring",
    "tags": ["sensor", "monitoring", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 0,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "type": "graph",
        "title": "CPU Usage by Sensor",
        "targets": [
          {
            "expr": "sensor_cpu_usage_percent",
            "legendFormat": "{{sensor_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "CPU %",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 2,
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "type": "graph",
        "title": "Memory Usage by Sensor",
        "targets": [
          {
            "expr": "sensor_memory_usage_percent",
            "legendFormat": "{{sensor_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Memory %",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "type": "graph",
        "title": "WebSocket Messages/sec",
        "targets": [
          {
            "expr": "rate(sensor_websocket_messages_total[1m])",
            "legendFormat": "{{sensor_id}} - {{exchange}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Messages/sec"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "type": "graph",
        "title": "Kafka Message Lag",
        "targets": [
          {
            "expr": "sensor_kafka_consumer_lag",
            "legendFormat": "{{sensor_id}} - {{topic}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Message Lag"
          }
        ]
      },
      {
        "id": 5,
        "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
        "type": "stat",
        "title": "Active Sensors",
        "targets": [
          {
            "expr": "count(up{job=\"sensor\"})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "green", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8},
        "type": "stat",
        "title": "Total Messages Processed",
        "targets": [
          {
            "expr": "sum(sensor_messages_processed_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
        "type": "stat",
        "title": "Average Latency",
        "targets": [
          {
            "expr": "avg(sensor_processing_latency_milliseconds)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8},
        "type": "table",
        "title": "Sensor Health Status",
        "targets": [
          {
            "expr": "sensor_health_status",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "sensor_id": "Sensor ID",
                "exchange": "Exchange",
                "status": "Status",
                "uptime": "Uptime",
                "last_check": "Last Check"
              }
            }
          }
        ]
      }
    ]
  }
}